# Dependencies
node_modules/

# Build artifacts
dist/
client/dist/
coverage/
logs/

# User data (SQLite + raw markdown lives here at runtime)
data/

# Secrets
.env
.env.local
*.pem

# OS / editor cruft
.DS_Store
*.log
