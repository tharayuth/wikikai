# Dependencies
node_modules/

# Build artifacts
dist/
client/dist/
coverage/
logs/

# User data (SQLite + raw markdown lives here at runtime)
data/

# Secrets — every .env variant (backups, per-host copies) except the template
.env
.env.*
!.env.example
*.pem

# OS / editor cruft
.DS_Store
*.log
.idea/
.vscode/
*.swp

# Claude Code state — the whole directory. settings.json is NOT safe to share
# here: the harness appends permission rules to it as a session runs, and
# those rules quote data paths, process names and hostnames of the machine.
.claude/

# Local DB backups (do not commit)
backups/

# Host-bound ops scripts — hardcode one pair of machines, meaningless in a
# fresh clone, and describe production layout. Keep them off the public repo.
sync-from-prod.sh
backup-prod.sh
dev-hmr.sh

# Production runbook and its backups — live on the production host only.
PRODUCTION.md
PRODUCTION.md.*

# Ad-hoc backup copies of anything
*.bak
*.bak-*

# Machine-specific context for Claude Code (hosts, paths, ssh targets)
CLAUDE.local.md

# Search-eval ground truth — its ids point at the live local database, so it
# is unusable in a fresh clone, and its queries name internal/customer systems.
test/fixtures/search-eval.json
